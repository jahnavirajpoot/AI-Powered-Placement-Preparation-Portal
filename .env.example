# =========================
# AP3 Environment
# =========================

APP_ENV=development
APP_NAME=AP3
DEBUG=true

# PostgreSQL
POSTGRES_DB=ap3
POSTGRES_USER=ap3
POSTGRES_PASSWORD=ap3_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://ap3:ap3_dev_password@postgres:5432/ap3

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ap3_minio
MINIO_SECRET_KEY=ap3_minio_password
MINIO_BUCKET=resumes
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=change-this-in-development
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Optional OpenAI
OPENAI_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1